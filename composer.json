{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Multi-user authentication and role management starter kit.",
    "keywords": ["laravel", "multi-user", "starter"],
    "license": "MIT",
    "require": {
        "php": "^7.2",
        "fideloper/proxy": "^4.2",
        "laravel/framework": "^6.0",
        "laravel/tinker": "^2.0",
        "yajra/laravel-datatables-oracle": "~9.0"
    },
    "require-dev": {
        "facade/ignition": "^1.4",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    }
}

